# ParaShift API Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

ENV=production          # development | production | test — REQUIRED
PORT=4000
# BIND_ADDR: interface to listen on. Default 127.0.0.1 in production (Caddy on the
# same host is the only client), all interfaces otherwise. 0.0.0.0 in a container.
BIND_ADDR=

# ── Database ───────────────────────────────────────────────────────────────────
# Use sslmode=require in production. sslmode=disable is only for local dev.
DATABASE_URL=postgres://parashift:REPLACE_ME@localhost:5432/parashift?sslmode=require
# RUN_MIGRATIONS: run file-based SQL migrations (golang-migrate) on startup.
# Set true in your deploy pipeline (init container / pre-deploy job).
# NEVER rely on every replica running migrations simultaneously.
RUN_MIGRATIONS=false
# AUTO_MIGRATE: GORM schema sync — MUST be false in production.
AUTO_MIGRATE=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# ── CORS ───────────────────────────────────────────────────────────────────────
# Production: set to exact frontend origin (HTTPS). No trailing slash.
ALLOWED_ORIGINS=https://app.yourdomain.com

# ── Socrate OAuth2 ────────────────────────────────────────────────────────────
# Compare names with this file; never paste Socrate's generated template (it says
# SOCRATE_ADMIN_BASE_URL, and its empty secret would erase the real one).
# Base URL = OAuth endpoints = expected token issuer. No trailing slash.
SOCRATE_BASE_URL=https://socrate.vandermoten.eu
SOCRATE_JWKS_URL=https://socrate.vandermoten.eu/.well-known/jwks.json
# Optional; defaults to SOCRATE_BASE_URL and must equal it in production.
SOCRATE_ISSUER=
# Admin API (service-account calls). REQUIRED in production, never derived.
# On the apps VPS: the SSH tunnel to Socrate's loopback admin API.
SOCRATE_ADMIN_URL=http://127.0.0.1:18082
# Numeric app ID given by the Socrate team. REQUIRED in production.
SOCRATE_APP_ID=7
SOCRATE_CLIENT_ID=REPLACE_ME
SOCRATE_CLIENT_SECRET=REPLACE_ME          # set on the VPS only; never commit a real value
SOCRATE_REDIRECT_URL=https://parashift.vandermoten.eu/callback

# ── AI (optional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_ME
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_TIMEOUT_SEC=30

# ── Logging & Observability ───────────────────────────────────────────────────
LOG_LEVEL=info          # debug | info | warn | error
METRICS_ENABLED=false

# OpenTelemetry tracing (OBS-3). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable.
# Point it at an OTLP/HTTP collector (host:port, no scheme), e.g. Tempo/Jaeger/Grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=false   # true to send over plaintext (in-cluster / dev)
OTEL_TRACES_SAMPLER_ARG=1.0         # head sampling ratio 0..1 (1 = sample everything)

# ── Request limits ────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=10485760   # 10 MB
