# ParaShift API Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

ENV=production          # development | production
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
# Use sslmode=require in production. sslmode=disable is only for local dev.
DATABASE_URL=postgres://parashift:REPLACE_ME@localhost:5432/parashift?sslmode=require
# RUN_MIGRATIONS: run file-based SQL migrations (golang-migrate) on startup.
# Set true in your deploy pipeline (init container / pre-deploy job).
# NEVER rely on every replica running migrations simultaneously.
RUN_MIGRATIONS=false
# AUTO_MIGRATE: GORM schema sync — MUST be false in production.
AUTO_MIGRATE=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# ── CORS ───────────────────────────────────────────────────────────────────────
# Production: set to exact frontend origin (HTTPS). No trailing slash.
ALLOWED_ORIGINS=https://app.yourdomain.com

# ── Socrate OAuth2 ────────────────────────────────────────────────────────────
SOCRATE_BASE_URL=https://golfperformance.fr
SOCRATE_ADMIN_URL=https://socrate-admin.golfperformance.fr
SOCRATE_CLIENT_ID=5FevumUD3pavFShhV3A8yA
SOCRATE_CLIENT_SECRET=As6Nt3ZunSt7XwLqpZBaTBKzJTU-Iflyj-D6lUR6UgQ
# SOCRATE_APP_ID: numeric app ID from the Socrate admin console.
# Leave empty to resolve automatically on first use.
SOCRATE_APP_ID=
SOCRATE_JWKS_URL=https://golfperformance.fr/.well-known/jwks.json
# REQUIRED in production: must match the 'iss' claim in tokens issued by Socrate.
# Prevents accepting tokens from unrelated issuers. Typically the Socrate base URL.
SOCRATE_ISSUER=https://golfperformance.fr
SOCRATE_REDIRECT_URL=https://app.yourdomain.com/callback

# ── AI (optional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_ME
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_TIMEOUT_SEC=30

# ── Logging & Observability ───────────────────────────────────────────────────
LOG_LEVEL=info          # debug | info | warn | error
METRICS_ENABLED=false

# ── Request limits ────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=10485760   # 10 MB
